# PostgreSQL na serveru (s dostupným rozšířením PostGIS)
DATABASE_URL=postgres://life360:heslo@localhost:5432/life360

# Přístupový token do aplikace (zadává se na přihlašovací obrazovce)
APP_ACCESS_TOKEN=change-me-long-random-string

# Tajemství pro podepisování session cookie (min. 32 znaků)
SESSION_SECRET=change-me-another-long-random-string

# 32 bajtů v hex (64 znaků) – šifruje Life360 token v DB
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Veřejný Mapbox token (pk.*) s URL restrikcí na vaši doménu
MAPBOX_TOKEN=pk.xxxxx

HOST=0.0.0.0
PORT=3000

# Nastavte na true, pokud aplikace běží za HTTPS
SECURE_COOKIES=false

# Nastavte na true, pokud běží za reverzní proxy (nginx/Caddy), aby se brala IP z X-Forwarded-For
TRUST_PROXY=false

# Interval dotazování Life360 (min. 15 s, ať nehrozí blokace)
POLL_INTERVAL_SECONDS=30

# Jak dlouho uchovávat historii poloh ve dnech (0 = navždy)
RETENTION_DAYS=90
